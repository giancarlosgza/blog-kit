{
  "name": "@giancarlosgza/blog-firebase",
  "version": "0.2.0",
  "description": "Firebase backend for the blog packages: Firestore and Storage rules, indexes and the scheduled-publish Cloud Function",
  "author": "Giancarlos Garza <giancarlosgza@gmail.com> (https://github.com/giancarlosgza)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./firestore.rules": "./firestore.rules",
    "./firestore.indexes.json": "./firestore.indexes.json",
    "./storage.rules": "./storage.rules"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./firestore.rules": "./firestore.rules",
      "./firestore.indexes.json": "./firestore.indexes.json",
      "./storage.rules": "./storage.rules"
    }
  },
  "files": [
    "dist",
    "firestore.indexes.json",
    "firestore.rules",
    "storage.rules"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-blog-kit \"vitest run --config vitest.rules.config.ts\""
  },
  "peerDependencies": {
    "firebase-admin": "^13.0.0 || ^14.0.0",
    "firebase-functions": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@giancarlosgza/blog-core": "workspace:^"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "tsdown": "0.23.0"
  }
}
