    "@colorffy/ui": "3.0.0",
    "@giancarlosgza/blog-layer": "workspace:^",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxtjs/robots": "6.2.4",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/core": "14.4.0",
    "floating-vue": "5.4.0",
    "sass": "1.105.1"
