{
  "name": "@giancarlosgza/blog-site-layer",
  "version": "0.1.0",
  "description": "Nuxt layer for a standalone blog site: the blog layer plus app shell, navbar/footer, PWA, robots, fonts and analytics",
  "author": "Giancarlos Garza <giancarlosgza@gmail.com> (https://github.com/giancarlosgza)",
  "type": "module",
  "main": "./nuxt.config.ts",
  "bin": {
    "blog-layer-subset-icons": "./scripts/subset-icons.mjs"
