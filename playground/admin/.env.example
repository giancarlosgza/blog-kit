# Firebase web config (client SDK)
NUXT_PUBLIC_VUEFIRE_CONFIG_API_KEY=
NUXT_PUBLIC_VUEFIRE_CONFIG_AUTH_DOMAIN=
NUXT_PUBLIC_VUEFIRE_CONFIG_PROJECT_ID=
NUXT_PUBLIC_VUEFIRE_CONFIG_STORAGE_BUCKET=
NUXT_PUBLIC_VUEFIRE_CONFIG_APP_ID=

# Service account (server routes and session cookies)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Admin origin (must match the deployed URL) and the public blog URL (with its base path when embedded)
NUXT_PUBLIC_SITE_URL=http://localhost:3032
NUXT_PUBLIC_BLOG_URL=http://localhost:3030

# Optional: Gemini and Plausible
NUXT_GEMINI_KEY=
NUXT_PLAUSIBLE_TOKEN=
NUXT_PUBLIC_PLAUSIBLE_SITE_ID=
NUXT_PUBLIC_PLAUSIBLE_BASE_URL=
NUXT_PUBLIC_PLAUSIBLE_BASE_URL_V2=
