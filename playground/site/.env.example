# Service Account (selects the Firebase project; every Firestore read uses it)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# SEO
NUXT_SITE_URL=http://localhost:3030
NUXT_SITE_NAME=
NUXT_SITE_ENV=
NUXT_APP_SECRET=

# Plausible Analytics (optional)
NUXT_PUBLIC_PLAUSIBLE_SCRIPT_ID=
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=
NUXT_PUBLIC_PLAUSIBLE_SCRIPT=

# Firestore emulator (optional, picked up by the Admin SDK)
# FIRESTORE_EMULATOR_HOST=
